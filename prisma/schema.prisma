generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(cuid())

  name     String
  email    String @unique
  password String
  role     String

  specialization String?
  description    String?

  requests RepairRequest[]
}

model RepairRequest {
  id         String @id @default(cuid())

  device     String
  service    String
  status     String
  master     String
  comment    String?
  date       String
  price      String?

  history    Json?

  clientId   String
  client     User @relation(fields: [clientId], references: [id])
}

model Service {
  id    String @id @default(cuid())

  name  String
}